# Silicon FCC SCF - Ground State
# Reference: ABINIT tutorial lesson 1 (https://docs.abinit.org/tutorial/base1/)
# Pseudopotential: Norm-conserving (Si)

ecut    30.0
nstep   100
toldfe  1.0e-8

# FCC lattice vectors (in atomic units)
acell   3*10.26
rprim   0.0 0.5 0.5
        0.5 0.0 0.5
        0.5 0.5 0.0

# Two atoms per primitive cell
natom   2
typat   1 1
znucl   14
xred    0.00 0.00 0.00
        0.25 0.25 0.25

# k-point sampling
kptopt  1
ngkpt   4 4 4

# Dielectric screening (Silicon ~12)
diemac  12.0
ixc     1
occopt  1
nband   10
