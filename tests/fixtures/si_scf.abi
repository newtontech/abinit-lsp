# Silicon FCC - ground state SCF calculation
# Primitive cell with norm-conserving pseudopotential

ecut    30.0
nstep   100
toldfe  1.0e-8

# Cell
acell   3*10.26
rprim   0.0 0.5 0.5
        0.5 0.0 0.5
        0.5 0.5 0.0

# Atoms
natom   2
typat   1 1
znucl   14
xred    0.00 0.00 0.00
        0.25 0.25 0.25

# k-points
kptopt  1
ngkpt   4 4 4

# Misc
diemac  12.0
ixc     1
occopt  1
nband   10
