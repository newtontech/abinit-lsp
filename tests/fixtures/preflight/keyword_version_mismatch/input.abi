# Uses ecutsm (abinit >=6.0) but the intent declares an older runtime
ecut    20.0
ecutsm  0.5

# Cell
acell   3*10.26
rprim   0.0 0.5 0.5
        0.5 0.0 0.5
        0.5 0.5 0.0

# Atoms
natom   2
ntypat  1
typat   1 1
znucl   14
xred    0.00 0.00 0.00
        0.25 0.25 0.25

# Pseudopotentials
pseudos 14-Si.psp8

# k-points
kptopt  1
ngkpt   4 4 4
